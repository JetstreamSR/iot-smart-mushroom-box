# Copy this file to .env and replace the placeholders.
# Do not commit the populated .env file.

WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY
FROST_BASE_URL=https://YOUR_FROST_HOST/v1.1
FROST_TEMPERATURE_DATASTREAM_ID=YOUR_TEMPERATURE_DATASTREAM_ID
FROST_HUMIDITY_DATASTREAM_ID=YOUR_HUMIDITY_DATASTREAM_ID

# Leave empty when the FROST server does not require a bearer token.
FROST_API_TOKEN=
